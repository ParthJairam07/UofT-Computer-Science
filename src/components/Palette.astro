<div class="palette-backdrop" data-palette-backdrop></div>
<div class="palette" role="dialog" aria-modal="true" aria-label="Search" data-palette>
  <input
    type="text"
    placeholder="Search courses, topics, resources…"
    autocomplete="off"
    spellcheck="false"
    data-palette-input
  />
  <div class="results" data-palette-results role="listbox"></div>
  <div class="foot">
    <span><kbd>↑↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </div>
</div>
