---
import '@fontsource-variable/newsreader';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Palette from '../components/Palette.astro';

interface Props {
  title?: string;
  description?: string;
  back?: { href: string; label: string };
}
const { title = 'UofTea', description = 'An open self-study map of the UTSC software engineering curriculum — every course, every resource, in one place.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = '/' + Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/g, '');
const back = path === '/' ? undefined : (Astro.props.back ?? { href: base, label: 'Home' });
const GOATCOUNTER = 'uoftea';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'UofTea' ? title : `${title} — UofTea`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='88'>%F0%9F%8D%B5</text></svg>" />
  </head>
  <body>
    <header class:list={['nav', { 'over-hero': path === '/' }]}>
      <div class="nav-left">
        {back && (
          <a class="back-btn" href={back.href} data-back>
            <span aria-hidden="true" class="arrow">←</span> <span class="back-label">{back.label}</span>
          </a>
        )}
        <a class="wordmark" href={base}><img src={`${base}/logo.png`} alt="UofTea" width="851" height="444" /></a>
      </div>
      <nav class="links">
        <a href={`${base}/#roadmap`} class="desktop-only">Roadmap</a>
        <a href={`${base}/#index`} class="desktop-only">Index</a>
        <a href={`${base}/map`} aria-current={path === '/map' ? 'page' : undefined}>Map</a>
        <a href={`${base}/guide`} aria-current={path === '/guide' ? 'page' : undefined}>Guide</a>
        <button class="kbd-hint" data-open-palette aria-label="Search (⌘K)">
          Search <span aria-hidden="true">⌘K</span>
        </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p>
          UofTea is an open-source, unofficial study companion. Course structure and resource
          recommendations come from independent research; the university owns its curriculum and
          trademarks. Nothing here is an official equivalency.
        </p>
        <div class="fcol">
          <span class="visitors" data-visitors data-site={GOATCOUNTER} hidden>Visitors <b>–</b></span>
          <a href="https://github.com" rel="noopener">GitHub</a>
          <a href={`${base}/guide`}>Method</a>
        </div>
      </div>
    </footer>

    <Palette />
    <script src="../lib/motion.ts"></script>
    <script src="../lib/palette.ts"></script>
    <script src="../lib/nav.ts"></script>
    <script src="../lib/counter.ts"></script>
  </body>
</html>
