---
import Base from '../layouts/Base.astro';
import guide from '../data/guide.json';
import data from '../data/courses.json';
---
<Base title="Guide" description="How to use UofTea — method, access, cost and the research basis behind the routes.">
  <header class="course-hero container">
    <nav class="crumb kicker"><a href="/">UofTea</a><span>/</span></nav>
    <h1 class="display" data-split>{guide.title.replace(/^Learn/, 'Learn')}</h1>
  </header>

  <div class="section container">
    <div class="guide-block prose" set:html={guide.intro} />

    <div class="guide-block rv">
      <h3>How to use this guide</h3>
      <div class="prose" set:html={guide.howToUse} />
    </div>

    <div class="guide-block rv">
      <h3>A recommended learning order</h3>
      <div class="prose" set:html={guide.learningOrderIntro} />
      <div class="stages" style="margin:1.5rem 0">
        {data.stages.map((s, i) => (
          <div class="stage">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 style="font-size:1.1rem">{s.name}</h3>
              <p class="outcome">{s.outcome}</p>
            </div>
            <div class="courses">
              {s.codes.map(code => <a class="code-chip" href={`/courses/${code.toLowerCase()}`}>{code}</a>)}
            </div>
          </div>
        ))}
      </div>
      <div class="prose" set:html={guide.learningOrderAfter} />
    </div>

    <div class="guide-block rv">
      <h3>Access, cost and equipment</h3>
      <div class="prose" set:html={guide.access} />
    </div>

    <div class="guide-block rv">
      <h3>Research basis</h3>
      <div class="prose" set:html={guide.researchBasis} />
    </div>
  </div>
</Base>
