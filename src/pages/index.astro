---
import Base from '../layouts/Base.astro';
import data from '../data/courses.json';

const base = import.meta.env.BASE_URL;
const { stages, courses } = data;
const byCode = new Map(courses.map(c => [c.code, c]));
---
<Base>
  <!-- hero -->
  <section class="hero">
    <img class="hero-img" src={`${base}/hero.jpg`} alt="" fetchpriority="high" />
    <div class="hero-content">
      <h1 class="display" data-split>This website is made by AI, but I have <em>manually verified every single course.</em></h1>
      <p class="lede">
        A course-by-course study guide for all 41 computer science, mathematics and statistics
        courses in the Software Engineering program — every route built from free, public material.
      </p>
    </div>
  </section>

  <!-- roadmap -->
  <section class="section container rv" id="roadmap">
    <div class="section-head">
      <span class="idx">01</span>
      <h2 class="display">The order of study</h2>
      <span class="kicker">Recommended, not required</span>
    </div>
    <div class="stages">
      {stages.map((s, i) => (
        <div class="stage rv">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.name}</h3>
          <div class="courses">
            {s.codes.map(code => (
              <a class="code-chip" href={`${base}/courses/${code.toLowerCase()}`}>{code}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- index -->
  <section class="section container rv" id="index">
    <div class="section-head">
      <span class="idx">02</span>
      <h2 class="display">Every course</h2>
      <span class="kicker"><kbd style="font:inherit;border:1px solid var(--line-strong);border-radius:3px;padding:.1rem .4rem">⌘K</kbd> to search</span>
    </div>
    <div class="index-table">
      {stages.map((s) => (
        <>
          <div class="index-group">Stage {s.index + 1} · {s.name} <span>— {s.codes.length} courses</span></div>
          {s.codes.map(code => {
            const c = byCode.get(code)!;
            return (
              <a class="index-row" href={`${base}/courses/${code.toLowerCase()}`}>
                <span class="code">{c.code}</span>
                <span class="title">{c.title}</span>
                <span class="subj">{c.code.slice(0, 3)}</span>
                <span class="stage-tag">→</span>
              </a>
            );
          })}
        </>
      ))}
    </div>
  </section>
</Base>
